{
  "name": "hospital_management_system",
  "version": "1.0.0",
  "description": "A full-stack clinic patient and appointment management workspace.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
